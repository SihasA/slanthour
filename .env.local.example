# ─── Slanthour environment ───────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Full database access — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC signing secret for page-password cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAGE_GATE_SECRET=your-random-32-byte-hex-secret

# ─── Arbor (separate product served at /arborAI) ──────────────────────
# Only needed if running the Arbor product. Unrelated to the Slanthour platform.
ARBOR_PASSWORD=
ARBOR_SESSION_SECRET=
